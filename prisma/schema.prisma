generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum RecommendationType {
  STRONGLY_RECOMMENDED
  RECOMMENDED
  NOT_RECOMMENDED
}

enum RelationType {
  PARENT
  CHILD
  RELATED
  COMPLEMENTARY
}

// -----------------------------------------------------------------------------
// TENANT / ORGANIZATION
// -----------------------------------------------------------------------------

model Organization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  logo             String?
  website          String?
  industry         String?
  size             String?
  country          String?  // ISO 3166-1 alpha-2, e.g. "IN", "US"
  subscriptionPlan String   @default("free") @map("subscription_plan")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  settings         OrganizationSettings?
  users            User[]
  jobs             Job[]
  jobPipelineStages JobPipelineStage[]
  assessments       Assessment[]
  subscriptions    Subscription[]
  organizationBilling OrganizationBilling?
  paymentMethods   PaymentMethod[]

  @@map("organizations")
}

model OrganizationSettings {
  id                   String  @id @default(uuid()) 
  organizationId       String  @unique @map("organization_id") 
  branding             Json?
  workflowRules        Json?   @map("workflow_rules")
  aiAssessmentEnabled  Boolean @default(false) @map("ai_assessment_enabled")
  aiInterviewerEnabled Boolean @default(false) @map("ai_interviewer_enabled")
  integrationsConfig   Json?   @map("integrations_config")
  seoSettings          Json?   @map("seo_settings")

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// -----------------------------------------------------------------------------
// USERS + AUTH (Compatible with Auth.js / NextAuth)
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid()) 
  organizationId String?   @map("organization_id") 
  role           String    @default("candidate") // admin, recruiter, hiring_manager, interviewer, candidate
  name           String?   // Auth.js compat
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  email          String?   @unique
  emailVerified  DateTime? @map("email_verified") // Auth.js compat
  image          String?   // Auth.js compat
  passwordHash   String?   @map("password_hash")
  phone          String?
  country        String?   // ISO 3166-1 alpha-2, e.g. "IN", "US"
  status         String    @default("active")
  lastLogin      DateTime? @map("last_login")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  accounts       Account[]     // Auth.js compat
  sessions       Session[]     // Auth.js compat
  candidate      Candidate?
  createdJobs    Job[]         @relation("JobCreator")
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  actions        CandidateAction[] // As recruiter

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) 
  userId            String  @map("user_id") 
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) 
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") 
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// CANDIDATE PROFILE INTELLIGENCE
// -----------------------------------------------------------------------------

model Candidate {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  profileSummary   String?   @map("profile_summary")
  totalExperience  Float?   @map("total_experience")
  currentRole      String?  @map("current_role")
  location         String?
  resumeUrl        String?  @map("resume_url")
  portfolioUrl     String?  @map("portfolio_url")
  linkedinUrl      String?  @map("linkedin_url")
  githubUrl        String?  @map("github_url")
  stackoverflowUrl String?  @map("stackoverflow_url")
  hackerrankUrl    String?  @map("hackerrank_url")

  // Derived AI fields (from skill intelligence engine)
  fitScore         Float?   @map("fit_score")
  recommendation   RecommendationType?

  // Fast filtering (important for recruiter UI)
  primarySkills    Json @map("primary_skills") // ["Java", "Python"]
  skillClusters    Json @map("skill_clusters") // ["Backend Engineer"]

  // Store full AI output (source of truth)
  skillIntelligence Json?   @map("skill_intelligence")
  graphSnapshot    Json?    @map("graph_snapshot")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           CandidateSkill[]
  inferredSkills   InferredSkill[]
  radar            CandidateCompetencyRadar?
  applications     CandidateApplication[]
  assessments      Assessment[]
  assessmentAttempts AssessmentAttempt[]
  interviewSessions InterviewSession[]
  aiInterviews      AiInterview[]
  jobMatches       JobCandidateMatch[]
  actions          CandidateAction[]
  proctoringEvents ProctoringEvent[]
  proctoringFlags  ProctoringFlag[]
  submissions      Submission[]
  skillAssessments SkillAssessment[]
  candidateScores  CandidateScore[]

  @@map("candidates")
}

model CandidateSkill {
  id               String    @id @default(uuid()) 
  candidateId      String    @map("candidate_id") 
  skillName        String    @map("skill_name")
  category         String?   // e.g. "technical", "soft_skill", "domain"
  score            Float?    // Out of 10 or 100
  confidenceScore  Float?    @map("confidence_score")
  source           String?   // e.g. "resume", "github", "assessment"
  lastVerifiedAt   DateTime? @map("last_verified_at")
  isValidated      Boolean   @default(false) @map("is_validated")
  validatedAt      DateTime? @map("validated_at")
  validationSource String?   @map("validation_source")

  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillName])
  @@map("candidate_skills")
}

// -----------------------------------------------------------------------------
// SKILL NORMALIZATION
// -----------------------------------------------------------------------------

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique // Canonical skill name (e.g., "JavaScript", "React")
  category  String   // "Programming Languages", "Frameworks", "Cloud & DevOps", etc.

  weight    Float    @default(0.5) // Importance in hiring context (0.0-1.0)

  aliases   Json     // Alternative names: ["js", "javascript", "es6"]

  // Relationships
  fromRelations SkillRelation[] @relation("FromSkill")
  toRelations   SkillRelation[] @relation("ToSkill")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model SkillRelation {
  id          String   @id @default(uuid())

  fromSkillId String   @map("from_skill_id")
  toSkillId   String   @map("to_skill_id")

  type        RelationType
  weight      Float    @default(1.0) // Strength of relationship

  fromSkill   Skill    @relation("FromSkill", fields: [fromSkillId], references: [id])
  toSkill     Skill    @relation("ToSkill", fields: [toSkillId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([fromSkillId, toSkillId, type])
  @@index([fromSkillId])
  @@index([toSkillId])
  @@map("skill_relations")
}

model CandidateCompetencyRadar {
  id                 String   @id @default(uuid()) 
  candidateId        String   @unique @map("candidate_id") 
  technicalDepth     Float?   @map("technical_depth")
  problemSolving     Float?   @map("problem_solving")
  communication      Float?
  leadership         Float?
  collaboration      Float?
  domainKnowledge    Float?   @map("domain_knowledge")
  systemDesign       Float?   @map("system_design")
  aiAssessmentScore  Float?   @map("ai_assessment_score")
  aiInterviewScore   Float?   @map("ai_interview_score")

  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_competency_radars")
}

// -----------------------------------------------------------------------------
// JOBS / ATS
// -----------------------------------------------------------------------------

model Job {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  title              String
  department         String?
  location           String?
  jobType            String?  @map("job_type")
  employmentType     String?  @map("employment_type")
  experienceRequired String?  @map("experience_required")
  salaryMin          Float?   @map("salary_min")
  salaryMax          Float?   @map("salary_max")
  currency           String?
  description        String
  requiredSkills     Json @map("required_skills") // Normalized skill names
  preferredSkills    Json @map("preferred_skills") // Normalized skill names
  skillClusters      Json @map("skill_clusters") // ["Frontend Developer"]
  seoSlug            String?  @map("seo_slug")
  publishedAt        DateTime? @map("published_at")
  status             String   @default("draft") // draft, published, closed, archived
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator            User               @relation("JobCreator", fields: [createdBy], references: [id])
  stages             JobPipelineStage[]
  applications       CandidateApplication[]
  assessments        Assessment[]
  interviews         InterviewSession[]
  aiInterviews       AiInterview[]
  candidateMatches   JobCandidateMatch[]
  actions            CandidateAction[]
  scores             CandidateScore[]

  @@map("jobs")
}

model JobPipelineStage {
  id             String  @id @default(uuid()) 
  organizationId String  @map("organization_id") 
  jobId          String  @map("job_id") 
  stageName      String  @map("stage_name")
  stageOrder     Int     @map("stage_order")

  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("job_pipeline_stages")
}

model CandidateApplication {
  id             String   @id @default(uuid()) 
  jobId          String   @map("job_id") 
  candidateId    String   @map("candidate_id") 
  currentStage   String   @map("current_stage")
  aiMatchScore   Float?   @map("ai_match_score")
  fraudRiskScore Float?   @map("fraud_risk_score")
  recruiterRating Int?    @map("recruiter_rating")
  status         String   @default("active") // active, rejected, hired, withdrawn
  appliedAt      DateTime @default(now()) @map("applied_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_applications")
}

// -----------------------------------------------------------------------------
// ASSESSMENT ENGINE
// -----------------------------------------------------------------------------

model Assessment {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  candidateId     String   @map("candidate_id")
  jobId           String?  @map("job_id")
  score           Float?
  difficulty      String
  report          Json
  language        String
  timeTaken       Int      @map("time_taken")
  attempts        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questions         AssessmentQuestion[]
  assessmentAttempts AssessmentAttempt[]
  proctoringLogs     ProctoringLog[]
  proctoringEvents   ProctoringEvent[]
  proctoringFlags    ProctoringFlag[]

  @@index([candidateId])
  @@index([jobId])
  @@index([createdAt])
  @@map("assessments")
}

model ProctoringLog {
  id             String    @id @default(cuid())
  assessmentId   String    @map("assessment_id")
  eventType      String    @map("event_type")
  timestamp      DateTime  @default(now())
  details        Json?

  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("proctoring_logs")
}

model ProctoringEvent {
  id            String   @id @default(cuid())
  assessmentId  String   @map("assessment_id")
  candidateId   String   @map("candidate_id")
  eventType     String   @map("event_type") // tab_switch, right_click, copy_attempt, etc.
  timestamp     DateTime @default(now())
  details       Json?

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate     Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([candidateId])
  @@map("proctoring_events")
}

model ProctoringFlag {
  id            String   @id @default(cuid())
  assessmentId  String   @map("assessment_id")
  candidateId   String   @map("candidate_id")
  reason        String
  severity      String   // low, medium, high
  flaggedAt     DateTime @default(now()) @map("flagged_at")
  reviewed      Boolean  @default(false)

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate     Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([candidateId])
  @@map("proctoring_flags")
}

model AssessmentQuestion {
  id             String  @id @default(uuid()) 
  assessmentId   String  @map("assessment_id") 
  questionType   String  @map("question_type")
  questionText   String   @map("question_text")
  expectedAnswer String?  @map("expected_answer")
  scoringRubric  Json?   @map("scoring_rubric")
  weightage      Float   @default(1.0)

  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers        Answer[]

  @@map("assessment_questions")
}

model Answer {
  id             String  @id @default(uuid()) 
  attemptId      String  @map("attempt_id") 
  questionId     String  @map("question_id") 
  answerText     String  @map("answer_text")
  isCorrect      Boolean?
  score          Float?
  submittedAt    DateTime @default(now()) @map("submitted_at")

  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model AssessmentAttempt {
  id             String   @id @default(uuid()) 
  candidateId    String   @map("candidate_id") 
  assessmentId   String   @map("assessment_id") 
  score          Float?
  startedAt      DateTime @default(now()) @map("started_at")
  fraudRiskScore Float?   @map("fraud_risk_score")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  candidate      Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  fraudSignals   FraudSignal[]
  answers        Answer[]

  @@map("assessment_attempts")
}

// -----------------------------------------------------------------------------
// AI INTERVIEW
// -----------------------------------------------------------------------------

model InterviewSession {
  id            String    @id @default(uuid()) 
  jobId         String    @map("job_id") 
  candidateId   String    @map("candidate_id") 
  sessionType   String    @map("session_type") // video, audio, text, coding
  status        String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  transcriptUrl String?   @map("transcript_url")
  videoUrl      String?   @map("video_url")
  audioUrl      String?   @map("audio_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  insights      InterviewInsight[]
  fraudSignals  FraudSignal[]

  @@map("interview_sessions")
}

model InterviewInsight {
  id                      String   @id @default(uuid())
  interviewSessionId      String   @map("interview_session_id")
  confidenceScore         Float?   @map("confidence_score")
  communicationScore      Float?   @map("communication_score")
  technicalScore          Float?   @map("technical_score")
  behavioralScore         Float?   @map("behavioral_score")
  riskScore               Float?   @map("risk_score")
  recommendation          String?

  // Video behavioral signals
  faceVisiblePercentage   Float?   @map("face_visible_percentage")
  lookingAwayPercentage   Float?   @map("looking_away_percentage")
  frameStability          Float?   @map("frame_stability")
  multipleFacesDetected   Boolean? @map("multiple_faces_detected")
  engagementScore         Float?   @map("engagement_score")
  behavioralSignalsData   Json?    @map("behavioral_signals_data") // Store full behavioral signals history

  interviewSession        InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@map("interview_insights")
}

// -----------------------------------------------------------------------------
// CHEAT RESISTANCE
// -----------------------------------------------------------------------------

model FraudSignal {
  id                  String   @id @default(uuid()) 
  candidateId         String?  @map("candidate_id") 
  assessmentAttemptId String?  @map("assessment_attempt_id") 
  interviewSessionId  String?  @map("interview_session_id") 
  signalType          String   @map("signal_type") // e.g., tab_switch, copy_paste, multiple_face_detected
  severity            String   // low, medium, high
  metadataJson        Json?    @map("metadata_json")
  createdAt           DateTime @default(now()) @map("created_at")

  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  interviewSession    InterviewSession?  @relation(fields: [interviewSessionId], references: [id], onDelete: SetNull)

  @@map("fraud_signals")
}

// -----------------------------------------------------------------------------
// BILLING & SUBSCRIPTION SYSTEM
// -----------------------------------------------------------------------------

model Plan {
  id          String @id @default(uuid()) 
  name        String
  type        String // organization, candidate
  tier        String // free, growth, pro, enterprise for org; free, pro for candidate
  price       Float
  currency    String @default("USD")
  interval    String @default("month") // month, year
  features    Json? // list of features
  limits      Json? // limits like job posts, etc.
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                      String @id @default(uuid()) 
  organizationId          String? 
  userId                  String?  // for candidate plans
  planId                  String 
  status                  String @default("active") // active, canceled, past_due, etc.
  currentPeriodStart      DateTime @map("current_period_start")
  currentPeriodEnd        DateTime @map("current_period_end")
  cancelAtPeriodEnd       Boolean @default(false) @map("cancel_at_period_end")
  stripeSubscriptionId    String? @unique @map("stripe_subscription_id")
  razorpaySubscriptionId  String? @unique @map("razorpay_subscription_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization            Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                    Plan @relation(fields: [planId], references: [id])
  usages                  Usage[]
  invoices                Invoice[]
  usageAlerts             UsageAlert[]

  @@map("subscriptions")
}

model Usage {
  id             String @id @default(uuid()) 
  subscriptionId String 
  metric         String // e.g. job_posts, candidate_unlocks, ai_interviews
  quantity       Int @default(0)
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("usages")
}

model Invoice {
  id                   String @id @default(uuid()) 
  subscriptionId       String 
  amount               Float
  currency             String @default("USD")
  status               String @default("draft") // draft, open, paid, void, uncollectible
  stripeInvoiceId      String? @unique @map("stripe_invoice_id")
  razorpayInvoiceId    String? @unique @map("razorpay_invoice_id")
  dueDate              DateTime? @map("due_date")
  paidAt               DateTime? @map("paid_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscription         Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments             Payment[]

  @@map("invoices")
}

model Payment {
  id                      String @id @default(uuid()) 
  invoiceId               String 
  amount                  Float
  currency                String @default("USD")
  status                  String @default("pending") // pending, succeeded, failed, canceled
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")
  razorpayPaymentId       String? @unique @map("razorpay_payment_id")
  gateway                 String // stripe, razorpay
  region                  String // global, india
  retryCount              Int @default(0) @map("retry_count")
  lastRetryAt             DateTime? @map("last_retry_at")
  paidAt                  DateTime? @map("paid_at")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  invoice                 Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PaymentMethod {
  id                String @id @default(uuid()) 
  organizationId    String? 
  userId            String? 
  gateway           String // stripe, razorpay
  gatewayMethodId   String @map("gateway_method_id") // payment method ID from gateway
  type              String // card, bank_account, etc.
  last4             String? // last 4 digits
  brand             String? // visa, mastercard, etc.
  expiryMonth       Int? @map("expiry_month")
  expiryYear        Int? @map("expiry_year")
  isDefault         Boolean @default(false) @map("is_default")
  status            String @default("active") // active, inactive, expired
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model WebhookEvent {
  id          String   @id @default(uuid()) 
  eventId     String
  gateway     String // stripe, razorpay
  eventType   String @map("event_type")
  payload     String
  processedAt DateTime @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([eventId, gateway])
  @@map("webhook_events")
}

model UsageAlert {
  id             String @id @default(uuid()) 
  subscriptionId String 
  metric         String // e.g. job_posts, candidate_unlocks
  threshold      Float // percentage (0-1) when alert was triggered
  currentUsage   Int @map("current_usage")
  limit          Int
  alertType      String @map("alert_type") // warning, critical
  message        String
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("usage_alerts")
}

model ABTest {
  id                   String @id @default(uuid()) 
  name                 String
  strategyA            Json @map("strategy_a") // PricingStrategy
  strategyB            Json @map("strategy_b") // PricingStrategy
  startDate            DateTime @map("start_date")
  endDate              DateTime? @map("end_date")
  targetUsers          Int @map("target_users")
  currentParticipants  Int @map("current_participants")
  results              Json? // { strategyA: { conversions, revenue }, strategyB: { conversions, revenue } }
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("ab_tests")
}

model IdempotencyKey {
  id               String   @id @default(uuid())
  key              String   @unique
  responseBody     String   @map("response_body")
  responseHeaders  Json     @map("response_headers")
  statusCode       Int      @map("status_code")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

model IdempotencyRetry {
  key   String @id
  count Int    @default(0)

  @@map("idempotency_retries")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  organizationId String?
  action         String
  resource       String
  resourceId     String?
  details        Json
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())
  severity       String   @default("medium") // low, medium, high, critical

  @@map("audit_logs")
}

model OrganizationBilling {
  id             String @id @default(uuid()) 
  organizationId String @unique 
  billingEmail   String? @map("billing_email")
  taxId          String? @map("tax_id")
  address        Json?
  paymentMethod  String? @map("payment_method") // stripe, razorpay
  region         String @default("global")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_billings")
}

// -----------------------------------------------------------------------------
// SKILL INFERENCE
// -----------------------------------------------------------------------------

model InferredSkill {
  id          String   @id @default(uuid())
  candidateId String   @map("candidate_id")

  skillName   String   @map("skill_name")
  confidence  Float    // 0.0 to 1.0
  reason      String   // Explanation for the inference
  inferenceType String @map("inference_type") // CO_OCCURRENCE, HIERARCHICAL, ROLE_BASED, GRAPH_BASED

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([skillName])
  @@map("inferred_skills")
}

// -----------------------------------------------------------------------------
// AI RANKING ENGINE
// -----------------------------------------------------------------------------

model JobCandidateMatch {
  id            String   @id @default(uuid())
  jobId         String   @map("job_id")
  candidateId   String   @map("candidate_id")
  score         Float    // Final ranking score (0-100)
  recommendation String  // "STRONGLY_RECOMMENDED", "RECOMMENDED", "NOT_RECOMMENDED"

  // Score breakdown for explainability
  scoreBreakdown Json    @map("score_breakdown") // {
  //   skillMatch: 0.85,
  //   skillDepth: 0.72,
  //   inferredSkillBoost: 0.15,
  //   experienceFit: 0.90,
  //   clusterMatch: 0.80,
  //   stability: 0.75
  // }

  // Detailed analysis for UI
  analysis      Json     @map("analysis") // {
  //   strongSkills: ["Java", "Spring Boot"],
  //   missingSkills: ["Kafka"],
  //   inferredSkills: [{ name: "Kafka", confidence: 0.68 }],
  //   skillGaps: ["Microservices"],
  //   roleFit: "Backend Engineer"
  // }

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([candidateId])
  @@index([score])
  @@map("job_candidate_matches")
}

// -----------------------------------------------------------------------------
// AI FEEDBACK LOOP
// -----------------------------------------------------------------------------

enum ActionType {
  VIEWED
  SHORTLISTED
  REJECTED
  INTERVIEWED
  HIRED
  IGNORED
}

model CandidateAction {
  id            String     @id @default(uuid())
  candidateId   String     @map("candidate_id")
  jobId         String     @map("job_id")
  recruiterId   String     @map("recruiter_id") // User who performed the action

  actionType    ActionType @map("action_type")
  weight        Float      @default(1.0) // Action weight for learning

  // Context for learning
  jobTitle      String?    @map("job_title") // Cached for analysis
  companyId     String?    @map("company_id") // Cached for company-specific learning

  // Optional metadata
  metadata      Json?      // Additional context (e.g., rejection reason, interview feedback)

  createdAt     DateTime   @default(now()) @map("created_at")

  candidate     Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job           Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiter     User       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([recruiterId])
  @@index([actionType])
  @@index([createdAt])
  @@map("candidate_actions")
}

// Learning weights and preferences per company/recruiter
model LearningPreference {
  id            String   @id @default(uuid())
  entityType    String   @map("entity_type") // "company" or "recruiter"
  entityId      String   @map("entity_id")   // organizationId or userId

  // Skill weight adjustments
  skillWeights  Json     @map("skill_weights") // { "Kafka": 0.2, "StartupExperience": 0.3 }

  // Ranking model adjustments
  rankingWeights Json    @map("ranking_weights") // { "skillMatch": 0.6, "experience": 0.15 }

  // Inference confidence multipliers
  inferenceMultipliers Json? @map("inference_multipliers") // { "CO_OCCURRENCE": 1.2 }

  // Success metrics for validation
  totalActions  Int      @default(0) @map("total_actions")
  successfulHires Int   @default(0) @map("successful_hires")
  accuracy      Float?   // Rolling accuracy metric

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@map("learning_preferences")
}

// -----------------------------------------------------------------------------
// AUTO-GRADING SYSTEM
// -----------------------------------------------------------------------------

model Submission {
  id             String   @id @default(uuid())
  candidateId    String   @map("candidate_id")
  questionId     String   @map("question_id")
  language       String
  code           String
  score          Float
  breakdown      Json     // { correctness, efficiency, codeQuality, edgeCases }
  feedback       Json     // AI review: { score, issues, strengths, suggestions }
  metrics        Json     // { totalTests, passedTests, failedTests, avgTime, maxMemory }
  testResults    Json     // Array of test case results
  behaviorSignals Json?   // Proctoring data: { suspicionScore, riskLevel, signals }
  createdAt      DateTime @default(now()) @map("created_at")

  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([questionId])
  @@index([createdAt])
  @@map("submissions")
}

model SkillAssessment {
  id             String   @id @default(uuid())
  candidateId    String   @map("candidate_id")
  skillName      String   @map("skill_name")
  score          Float    // 0-100
  confidence     Float    // 0-1, how confident we are in this assessment
  source         String   // "auto-grading", "manual-review", "behavioral"
  context        Json?    // Additional context about the assessment
  createdAt      DateTime @default(now()) @map("created_at")

  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillName, source])
  @@index([candidateId])
  @@index([skillName])
  @@map("skill_assessments")
}

// -----------------------------------------------------------------------------
// DECISION ENGINE
// -----------------------------------------------------------------------------

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model CandidateScore {
  id                String           @id @default(uuid())
  candidateId       String           @map("candidate_id")
  jobId             String           @map("job_id")
  fitScore          Float            // 0-100 overall fit score
  recommendation    RecommendationType
  confidence        ConfidenceLevel

  // Score breakdown by signal type
  profileSignals    Float            @map("profile_signals")    // Skills, experience, tech stack
  assessmentSignals Float            @map("assessment_signals") // Coding tests, skill validation
  codeIntelligence  Float            @map("code_intelligence")  // Code quality, engineering thinking
  interviewSignals  Float            @map("interview_signals")  // Communication, problem solving
  behaviorSignals   Float            @map("behavior_signals")   // Attention, suspicion (negative weight)

  // Raw signal data (for explainability and debugging)
  signals           Json             // Complete SignalData object

  // Human-readable explanation
  explanation       Json             // { strengths, weaknesses, summary, riskFactors }

  // Metadata
  signalCompleteness Float           @map("signal_completeness") // 0-100, percentage of signals available
  confidenceFactors  Json            @map("confidence_factors")  // Array of factors contributing to confidence
  processedAt       DateTime         @default(now())             @map("processed_at")

  // Learning loop data
  recruiterFeedback Json?            @map("recruiter_feedback")  // { accepted, rejected, notes, adjustments }
  feedbackApplied   Boolean          @default(false)             @map("feedback_applied")

  createdAt         DateTime         @default(now())             @map("created_at")
  updatedAt         DateTime         @updatedAt                  @map("updated_at")

  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job               Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([fitScore])
  @@index([recommendation])
  @@index([processedAt])
  @@map("candidate_scores")
}

// -----------------------------------------------------------------------------
// AI INTERVIEWER
// -----------------------------------------------------------------------------

model AiInterview {
  id          String    @id @default(uuid())
  candidateId String    @map("candidate_id")
  jobId       String?   @map("job_id")
  language    String
  code        String
  analysis    Json
  questions   Json
  answers     Json      @default("[]")
  evaluations Json      @default("[]")
  finalScore  Float?    @map("final_score")
  finalEval   Json?     @map("final_eval")
  status      String    @default("in_progress")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@map("ai_interviews")
}
