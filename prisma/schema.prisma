generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// TENANT / ORGANIZATION
// -----------------------------------------------------------------------------

model Organization {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  logo             String?
  website          String?
  industry         String?
  size             String?
  subscriptionPlan String   @default("free") @map("subscription_plan")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  settings         OrganizationSettings?
  users            User[]
  jobs             Job[]
  jobPipelineStages JobPipelineStage[]
  assessments       Assessment[]

  @@map("organizations")
}

model OrganizationSettings {
  id                   String  @id @default(uuid()) @db.Uuid
  organizationId       String  @unique @map("organization_id") @db.Uuid
  branding             Json?
  workflowRules        Json?   @map("workflow_rules")
  aiAssessmentEnabled  Boolean @default(false) @map("ai_assessment_enabled")
  aiInterviewerEnabled Boolean @default(false) @map("ai_interviewer_enabled")
  integrationsConfig   Json?   @map("integrations_config")
  seoSettings          Json?   @map("seo_settings")

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// -----------------------------------------------------------------------------
// USERS + AUTH (Compatible with Auth.js / NextAuth)
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  role           String    @default("candidate") // admin, recruiter, hiring_manager, interviewer, candidate
  name           String?   // Auth.js compat
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  email          String?   @unique
  emailVerified  DateTime? @map("email_verified") // Auth.js compat
  image          String?   // Auth.js compat
  passwordHash   String?   @map("password_hash")
  phone          String?
  status         String    @default("active")
  lastLogin      DateTime? @map("last_login")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  accounts       Account[]     // Auth.js compat
  sessions       Session[]     // Auth.js compat
  candidate      Candidate?
  createdJobs    Job[]         @relation("JobCreator")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// CANDIDATE PROFILE INTELLIGENCE
// -----------------------------------------------------------------------------

model Candidate {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  profileSummary   String?  @db.Text @map("profile_summary")
  totalExperience  Float?   @map("total_experience")
  currentRole      String?  @map("current_role")
  location         String?
  resumeUrl        String?  @map("resume_url")
  portfolioUrl     String?  @map("portfolio_url")
  linkedinUrl      String?  @map("linkedin_url")
  githubUrl        String?  @map("github_url")
  stackoverflowUrl String?  @map("stackoverflow_url")
  hackerrankUrl    String?  @map("hackerrank_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           CandidateSkill[]
  radar            CandidateCompetencyRadar?
  applications     CandidateApplication[]
  assessments      AssessmentAttempt[]

  @@map("candidates")
}

model CandidateSkill {
  id               String    @id @default(uuid()) @db.Uuid
  candidateId      String    @map("candidate_id") @db.Uuid
  skillName        String    @map("skill_name")
  category         String?   // e.g. "technical", "soft_skill", "domain"
  score            Float?    // Out of 10 or 100
  confidenceScore  Float?    @map("confidence_score")
  source           String?   // e.g. "resume", "github", "assessment"
  lastVerifiedAt   DateTime? @map("last_verified_at")

  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_skills")
}

model CandidateCompetencyRadar {
  id                 String   @id @default(uuid()) @db.Uuid
  candidateId        String   @unique @map("candidate_id") @db.Uuid
  technicalDepth     Float?   @map("technical_depth")
  problemSolving     Float?   @map("problem_solving")
  communication      Float?
  leadership         Float?
  collaboration      Float?
  domainKnowledge    Float?   @map("domain_knowledge")
  systemDesign       Float?   @map("system_design")
  aiAssessmentScore  Float?   @map("ai_assessment_score")
  aiInterviewScore   Float?   @map("ai_interview_score")

  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_competency_radars")
}

// -----------------------------------------------------------------------------
// JOBS / ATS
// -----------------------------------------------------------------------------

model Job {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  title              String
  department         String?
  location           String?
  jobType            String?  @map("job_type")
  employmentType     String?  @map("employment_type")
  experienceRequired String?  @map("experience_required")
  salaryMin          Float?   @map("salary_min")
  salaryMax          Float?   @map("salary_max")
  currency           String?
  description        String   @db.Text
  requiredSkills     Json?    @map("required_skills")
  preferredSkills    Json?    @map("preferred_skills")
  seoSlug            String?  @map("seo_slug")
  publishedAt        DateTime? @map("published_at")
  status             String   @default("draft") // draft, published, closed, archived
  createdBy          String   @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator            User               @relation("JobCreator", fields: [createdBy], references: [id])
  stages             JobPipelineStage[]
  applications       CandidateApplication[]
  assessments        Assessment[]
  interviews         InterviewSession[]

  @@map("jobs")
}

model JobPipelineStage {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  jobId          String  @map("job_id") @db.Uuid
  stageName      String  @map("stage_name")
  stageOrder     Int     @map("stage_order")

  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("job_pipeline_stages")
}

model CandidateApplication {
  id             String   @id @default(uuid()) @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  currentStage   String   @map("current_stage")
  aiMatchScore   Float?   @map("ai_match_score")
  fraudRiskScore Float?   @map("fraud_risk_score")
  recruiterRating Int?    @map("recruiter_rating")
  status         String   @default("active") // active, rejected, hired, withdrawn
  appliedAt      DateTime @default(now()) @map("applied_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_applications")
}

// -----------------------------------------------------------------------------
// ASSESSMENT ENGINE
// -----------------------------------------------------------------------------

model Assessment {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  jobId           String?  @map("job_id") @db.Uuid
  type            String   // e.g. mcq, coding, communication, scenario
  difficulty      String?
  durationMinutes Int?     @map("duration_minutes")
  generatedByAi   Boolean  @default(false) @map("generated_by_ai")
  createdAt       DateTime @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job             Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@map("assessments")
}

model AssessmentQuestion {
  id             String  @id @default(uuid()) @db.Uuid
  assessmentId   String  @map("assessment_id") @db.Uuid
  questionType   String  @map("question_type")
  questionText   String  @db.Text @map("question_text")
  expectedAnswer String? @db.Text @map("expected_answer")
  scoringRubric  Json?   @map("scoring_rubric")
  weightage      Float   @default(1.0)

  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_questions")
}

model AssessmentAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  assessmentId   String   @map("assessment_id") @db.Uuid
  score          Float?
  fraudRiskScore Float?   @map("fraud_risk_score")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  candidate      Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  fraudSignals   FraudSignal[]

  @@map("assessment_attempts")
}

// -----------------------------------------------------------------------------
// AI INTERVIEW
// -----------------------------------------------------------------------------

model InterviewSession {
  id            String    @id @default(uuid()) @db.Uuid
  jobId         String    @map("job_id") @db.Uuid
  candidateId   String    @map("candidate_id") @db.Uuid
  sessionType   String    @map("session_type") // video, audio, text, coding
  status        String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  transcriptUrl String?   @map("transcript_url")
  videoUrl      String?   @map("video_url")
  audioUrl      String?   @map("audio_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  insights      InterviewInsight[]
  fraudSignals  FraudSignal[]

  @@map("interview_sessions")
}

model InterviewInsight {
  id                 String  @id @default(uuid()) @db.Uuid
  interviewSessionId String  @map("interview_session_id") @db.Uuid
  confidenceScore    Float?  @map("confidence_score")
  communicationScore Float?  @map("communication_score")
  technicalScore     Float?  @map("technical_score")
  behavioralScore    Float?  @map("behavioral_score")
  riskScore          Float?  @map("risk_score")
  recommendation     String? @db.Text

  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@map("interview_insights")
}

// -----------------------------------------------------------------------------
// CHEAT RESISTANCE
// -----------------------------------------------------------------------------

model FraudSignal {
  id                  String   @id @default(uuid()) @db.Uuid
  candidateId         String?  @map("candidate_id") @db.Uuid
  assessmentAttemptId String?  @map("assessment_attempt_id") @db.Uuid
  interviewSessionId  String?  @map("interview_session_id") @db.Uuid
  signalType          String   @map("signal_type") // e.g., tab_switch, copy_paste, multiple_face_detected
  severity            String   // low, medium, high
  metadataJson        Json?    @map("metadata_json")
  createdAt           DateTime @default(now()) @map("created_at")

  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  interviewSession    InterviewSession?  @relation(fields: [interviewSessionId], references: [id], onDelete: SetNull)

  @@map("fraud_signals")
}
